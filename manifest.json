{
  "manifest_version": 3,
  "name": "Mekuri PDF Reader",
  "version": "1.4.0",
  "description": "Read PDFs with pages that turn like paper. Click the toolbar button on a PDF tab to open it in the reader.",
  "action": {
    "default_title": "Open in Mekuri",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}